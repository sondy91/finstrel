#!/bin/sh
set -eu
subject=$(sed -n '1p' "$1")
# Git-generated merge, revert, fixup, and squash subjects have their own format.
case "$subject" in
  'Merge '*|'Revert '*|'fixup! '*|'squash! '*) exit 0 ;;
esac
if ! printf '%s\n' "$subject" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([A-Za-z0-9._/-]+\))?!?: [^[:space:]](.*[^[:space:]])?$'; then
  printf '%s\n' 'Use a Conventional Commit subject, e.g. feat(budget): add rollover' >&2
  exit 1
fi
case "$subject" in
  feat:*|feat\(*\):*|feat!:*|feat\(*\)!:*|fix:*|fix\(*\):*|fix!:*|fix\(*\)!:*)
    if ! grep -Eiq '(^|[^A-Za-z0-9_])(refs?|references|fix(es|ed|ing)?|clos(e|es|ed|ing)|resolv(e|es|ed|ing)|part of|relates to|related to)[[:space:]]+[A-Z][A-Z0-9]+-[0-9]+([^A-Za-z0-9_]|$)' "$1"; then
      printf '%s\n' 'Feature and fix commits need a Linear issue reference, e.g. Refs AS-46.' >&2
      exit 1
    fi
    ;;
esac
